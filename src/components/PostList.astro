---
import { dateText, postSlug, taxonomyPath } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-row">
      <time datetime={post.data.publishedAt.toISOString()}>{dateText(post.data.publishedAt)}</time>
      <div>
        <h2><a href={`/writing/${postSlug(post.id)}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <nav class="post-taxonomy" aria-label={`${post.data.title}的分类与标签`}>
          <a href={taxonomyPath('categories', post.data.category)}>{post.data.category}</a>
          {post.data.tags.map((tag) => <a href={taxonomyPath('tags', tag)}>#{tag}</a>)}
        </nav>
      </div>
    </article>
  ))}
</div>
