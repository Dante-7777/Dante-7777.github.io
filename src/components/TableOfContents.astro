---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{items.length > 0 && (
  <details class="article-toc" open>
    <summary>此页目录</summary>
    <nav aria-label="文章目录">
      {items.map((heading) => (
        <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>
      ))}
    </nav>
  </details>
)}
