---
import ThemeControl from './ThemeControl.astro';
const path = Astro.url.pathname;
const nav = [
  ['/', '首页'],
  ['/writing/', '文章'],
  ['/topics/', '主题'],
  ['/about/', '关于'],
];
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Akatsuki 首页"><span class="wordmark-seal">曉</span><b>Akatsuki</b></a>
  <nav aria-label="主导航">
    {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="header-tools">
    <a href="/search/">搜索</a>
    <ThemeControl />
  </div>
</header>
