---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { postSlug, visiblePosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('posts'));
  return posts.map((post, index) => ({ params: { slug: postSlug(post.id) }, props: { post, newer: posts[index - 1], older: posts[index + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---
<PostLayout post={post} headings={headings} newer={newer} older={older}><Content /></PostLayout>
