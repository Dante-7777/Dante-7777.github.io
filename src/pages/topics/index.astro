---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { taxonomyPath, visiblePosts } from '../../lib/posts';
const posts = visiblePosts(await getCollection('posts'));
const categories = [...new Set(posts.map((post) => post.data.category))].map((name) => ({ name, count: posts.filter((post) => post.data.category === name).length }));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }));
---
<BaseLayout title="主题">
  <header class="page-heading"><p class="eyebrow">TOPICS</p><h1>主题</h1><p>从分类和标签进入不同的写作线索。</p></header>
  <section class="topic-section"><h2>分类</h2><div class="topic-grid">{categories.map((item) => <a href={taxonomyPath('categories', item.name)}><strong>{item.name}</strong><span>{String(item.count).padStart(2, '0')}</span></a>)}</div></section>
  <section class="topic-section"><h2>标签</h2><div class="tag-cloud">{tags.map((tag) => <a href={taxonomyPath('tags', tag.name)}>#{tag.name}<small>{tag.count}</small></a>)}</div></section>
</BaseLayout>
