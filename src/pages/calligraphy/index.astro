---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="字帖" description="输入一个汉字，在书法字典查阅历代草书写法。">
  <div class="calligraphy-page">
    <header class="calligraphy-heading">
      <p class="eyebrow">字帖 <span lang="ja">文字のかたち</span></p>
      <h1>一字一境，<br />落笔有风。</h1>
      <p>想看一个字的草书写法？写下它，再到书法字典查阅不同书家的字迹。</p>
    </header>

    <div class="calligraphy-board">
      <div class="calligraphy-paper" aria-label="所输入汉字的字帖式预览">
        <span class="calligraphy-paper-label">临字 · 草书索引</span>
        <div class="calligraphy-grid" aria-hidden="true"><span data-character-preview>暁</span></div>
        <span class="calligraphy-paper-foot">此处仅为普通字体预览，并非草书范字</span>
      </div>
      <div class="calligraphy-panel">
        <span class="calligraphy-section-number">01 / 查一字</span>
        <h2>在字间，寻笔意。</h2>
        <p>输入一个汉字，点击后将在新页面打开书法字典的草书查询结果。本站不保存或转载其字形图片。</p>
        <form data-calligraphy-form action="https://www.shufazidian.com/s.php" method="post" target="_blank">
          <label for="calligraphy-character">要查的字</label>
          <div class="calligraphy-input-row">
            <input id="calligraphy-character" name="wd" type="text" inputmode="text" autocomplete="off" placeholder="例如：晓" required aria-describedby="calligraphy-error" />
            <input type="hidden" name="sort" value="7" />
            <button type="submit">查草书 <span aria-hidden="true">↗</span></button>
          </div>
          <p id="calligraphy-error" class="calligraphy-error" role="alert" hidden>请只输入一个汉字。</p>
        </form>
        <div class="calligraphy-example">试试 <button type="button" data-example="晓">晓</button><button type="button" data-example="月">月</button><button type="button" data-example="风">风</button></div>
        <p class="calligraphy-source">查询由 <a href="https://www.shufazidian.com/" target="_blank" rel="noopener noreferrer">书法字典 ↗</a> 提供；结果与使用规则以原站为准。</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-calligraphy-form]');
  const input = document.querySelector<HTMLInputElement>('#calligraphy-character');
  const preview = document.querySelector<HTMLElement>('[data-character-preview]');
  const error = document.querySelector<HTMLElement>('#calligraphy-error');
  const showCharacter = () => {
    const character = Array.from(input?.value.trim() || '')[0];
    if (preview) preview.textContent = character || '暁';
    if (error) error.hidden = true;
  };
  input?.addEventListener('input', showCharacter);
  form?.addEventListener('submit', (event) => {
    const character = input?.value.trim() || '';
    if (!/^\p{Script=Han}$/u.test(character)) {
      event.preventDefault();
      if (error) error.hidden = false;
      input?.focus();
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!input) return;
      input.value = button.dataset.example || '';
      showCharacter();
      input.focus();
    });
  });
</script>
